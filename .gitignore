# Rust
/target
**/target
Cargo.lock

# Node / frontend
node_modules
desktop/dist
desktop/node_modules

# Ladle (component story explorer) production build output
desktop/build
desktop/e2e/artifacts

# Tauri build artifacts
desktop/src-tauri/target
desktop/src-tauri/gen

# Bundled EasyTier binaries (downloaded by scripts/fetch-easytier.sh, ~30MB; never
# committed). Keep the dir + its README so the tauri `resources` glob always matches.
desktop/src-tauri/resources/easytier/*
!desktop/src-tauri/resources/easytier/README.md

# Bundled InterMed executable and version stamp. Keep the documentation and
# upstream license in git; release CI fetches or builds the pinned binary.
desktop/src-tauri/resources/intermed/*
!desktop/src-tauri/resources/intermed/README.md
!desktop/src-tauri/resources/intermed/LICENSE

# Secrets / local env
.env
**/.env
!**/.env.example

# Supabase CLI scaffolding
supabase/.temp
supabase/.branches

# OS / editor
.DS_Store
*.log
.gstack/

# Reference launchers (study only, not part of this project)
ref/

# Ephemeral agent worktrees (claude-code worktree isolation) — never commit
.claude/worktrees/
